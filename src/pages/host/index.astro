---
import Base from "../../layouts/Base.astro";
import HostForm from "../../components/HostForm.astro";
import Faq from "../../components/Faq.astro";
import { hostSteps, site } from "../../site";

---

<Base title="Bring vending to your location" description="Get a free refrigerated smart AI vending machine for your business in Belmont, Gastonia, Charlotte and nearby. Family-owned Oogum Vending stocks it, cleans it and keeps it running." faq>
  <section class="mx-auto grid w-full max-w-6xl gap-8 px-4 pt-6 pb-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
    <div class="flex flex-col gap-6">
      <p class="font-semibold text-lime-dark">Free to host. Family owned.</p>
      <h1 class="text-4xl text-ink sm:text-5xl">Give your customers something cold to grab.</h1>
      <p class="text-lg text-muted">
        Tell us a little about your spot and Stephen or Nancy will get back to you. We'll come take a look, and if it's a fit, we'll bring the machine. Rather talk? Call {site.phone}.
      </p>
      <ol class="flex flex-col gap-4">
        {
          hostSteps.map((s, i) => (
            <li class="flex gap-4">
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <span class="flex flex-col gap-1">
                <span class="text-lg font-bold text-ink">{s.title}</span>
                <span class="text-muted">{s.body}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
    <HostForm />
  </section>
  <Faq heading="Before you ask" />
</Base>

<style>
  .step-num {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-lime);
    font-weight: 800;
    color: var(--color-ink);
  }
</style>
