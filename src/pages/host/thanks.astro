---
import Base from "../../layouts/Base.astro";
---

<Base title="Request sent" noindex>
  <section class="mx-auto flex w-full max-w-2xl flex-col items-start gap-6 px-4 py-20 sm:px-6">
    <p class="rounded-full bg-lime-soft px-4 py-1 font-semibold text-lime-dark">Thank you. Request received.</p>
    <h1 class="text-4xl text-ink sm:text-5xl">We'll be in touch.</h1>
    <p class="text-lg text-muted">Stephen or Nancy will reach out within a couple of business days. If you picked a call time, watch for an email confirming it.</p>
    <a href="/" class="key px-5 py-3">Back to the machine</a>
  </section>
</Base>
