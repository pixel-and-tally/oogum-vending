---
import Base from "../layouts/Base.astro";
import Fridge from "../components/Fridge.astro";
import { promises, site } from "../site";
---

<Base>
  <section class="mx-auto grid w-[min(100%-2rem,72rem)] items-center gap-10 pt-6 pb-12 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
    <div class="flex flex-col items-start gap-6">
      <p class="rounded-full bg-lime-soft px-4 py-1.5 font-semibold text-lime-dark">Smart vending for {site.serviceArea}</p>
      <h1 class="text-[clamp(2.8rem,8vw,5.5rem)] leading-[0.95] text-ink">
        Convenience,<br /><span class="text-lime-dark">Reimagined.</span>
      </h1>
      <span class="h-2 w-28 rounded-full bg-lime" aria-hidden="true"></span>
      <p class="max-w-xl text-xl text-muted">
        Great choices. Happy people. <strong class="text-orange-dark">Better business.</strong> We put a smart vending machine in your spot, keep it stocked and running, and it costs you nothing.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/host/" class="key key-vend px-6 py-3 text-lg">Host a machine</a>
        {site.phone && <a href={`tel:${site.phone}`} class="key px-6 py-3 text-lg">Call {site.phone}</a>}
      </div>
    </div>
    <figure class="photo">
      <span class="photo-disc" aria-hidden="true"></span>
      <img src="/machine-photo.png" alt="An Oogum smart vending machine: a black glass-door fridge stocked with drinks and snacks" width="231" height="485" />
    </figure>
  </section>

  <!-- Navy band with the flier's three promises. -->
  <div class="mb-14 bg-cabinet py-4">
    <ul class="mx-auto flex w-[min(100%-2rem,72rem)] flex-wrap items-center justify-center gap-x-5 gap-y-2 font-display text-lg font-semibold uppercase tracking-wide text-frost sm:text-2xl">
      {
        promises.map((p, i) => (
          <>
            {i > 0 && <li class="h-6 w-1 rounded bg-lime" aria-hidden="true" />}
            <li>{p}</li>
          </>
        ))
      }
    </ul>
  </div>

  <Fridge />

  <section class="mx-auto flex w-[min(100%-2rem,72rem)] flex-col items-center gap-4 pb-16 text-center">
    <h2 class="text-3xl text-ink sm:text-4xl">Let's find the right vending solution for your location.</h2>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/host/" class="key key-vend px-6 py-3">Host a machine</a>
      {site.phone && <a href={`tel:${site.phone}`} class="key px-6 py-3">Call {site.phone}</a>}
    </div>
    {site.email && <a href={`mailto:${site.email}`} class="text-muted underline">{site.email}</a>}
  </section>
</Base>

<style>
  .photo {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1rem 0 0;
  }
  .photo-disc {
    position: absolute;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-lime-soft);
  }
  .photo img {
    position: relative;
    width: min(70%, 15rem);
    height: auto;
    filter: drop-shadow(0 24px 18px rgb(1 32 76 / 0.3));
  }
</style>
