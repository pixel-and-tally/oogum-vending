---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { cornerstones, locations, promises, site, steps } from "../site";

const tones = {
  orange: "bg-orange-soft text-orange-dark",
  lime: "bg-lime-soft text-lime-dark",
  sky: "bg-sky-soft text-cabinet-2",
  sun: "bg-sun-soft text-orange-dark",
  ink: "bg-ink-soft text-ink",
} as const;
const bars = { orange: "bg-orange", lime: "bg-lime", sky: "bg-sky", sun: "bg-sun", ink: "bg-ink" } as const;
---

<Base>
  <!-- Hero: short pitch on the left, their machine on the right. -->
  <section class="hero">
    <div class="mx-auto grid w-[min(100%-2rem,72rem)] items-center gap-10 pt-12 pb-16 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <div class="flex flex-col items-start gap-6">
        <p class="eyebrow">Smart vending for {site.serviceArea}</p>
        <h1 class="text-[clamp(2.3rem,5vw,3.75rem)] text-ink">A vending machine with more options.</h1>
        <p class="max-w-xl text-xl leading-relaxed text-muted">
          Upgrade your store with a smart fridge full of cold drinks, snacks and healthier picks. Customers tap, grab and go. We stock it and keep it running, and it costs you nothing.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/host/" class="key key-vend px-7 py-3.5 text-lg">Host a machine</a>
          {site.phone && <a href={`tel:${site.phone}`} class="key px-7 py-3.5 text-lg">Call {site.phone}</a>}
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 pt-2 text-sm font-semibold text-ink">
          {
            promises.map((p) => (
              <li class="flex items-center gap-2">
                <span class="grid size-5 place-items-center rounded-full bg-lime text-ink" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                </span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="photo">
        <span class="photo-bg" aria-hidden="true"></span>
        <img src="/machine-photo.png" alt="An Oogum smart vending machine: a black glass-door fridge stocked with drinks and snacks" width="231" height="485" />
        <figcaption class="badge badge-top">
          <span class="badge-dot bg-sky"></span>Tap, grab and go
        </figcaption>
        <p class="badge badge-bottom" aria-hidden="true">
          <span class="badge-dot bg-lime"></span>Stocked and serviced by us
        </p>
      </figure>
    </div>
  </section>

  <!-- The five cornerstones from the flier. -->
  <section class="mx-auto w-[min(100%-2rem,72rem)] py-20" aria-labelledby="cornerstones">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
      <p class="eyebrow">Why choose Oogum Vending?</p>
      <h2 id="cornerstones" class="text-[clamp(1.9rem,4vw,2.75rem)] text-ink">The five cornerstones we're built on.</h2>
    </div>
    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {
        cornerstones.map((c, i) => (
          <li class:list={["card relative flex flex-col gap-4 overflow-hidden p-7", i < 3 ? "lg:col-span-2" : "lg:col-span-3", i === 4 && "sm:col-span-2 lg:col-span-3"]}>
            <span class:list={["absolute inset-x-0 top-0 h-1.5", bars[c.tone]]} aria-hidden="true" />
            <div class="flex items-start justify-between">
              <span class:list={["grid size-14 place-items-center rounded-2xl", tones[c.tone]]}>
                <Icon name={c.icon} class="size-7" />
              </span>
              <span class="font-display text-4xl leading-none text-line" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="text-xl text-ink">{c.title}</h3>
            <p class="text-muted">{c.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- How a customer buys. -->
  <section class="bg-tint py-20" aria-labelledby="how">
    <div class="mx-auto w-[min(100%-2rem,72rem)]">
      <div class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
        <p class="eyebrow">How it works</p>
        <h2 id="how" class="text-[clamp(1.9rem,4vw,2.75rem)] text-ink">Buying takes three steps.</h2>
      </div>
      <ol class="steps mt-12 grid gap-8 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="relative flex flex-col items-center gap-3 text-center">
              <span class="step-num">{i + 1}</span>
              <h3 class="text-xl text-ink">{s.title}</h3>
              <p class="max-w-xs text-muted">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Call to action. -->
  <section class="mx-auto w-[min(100%-2rem,72rem)] py-20">
    <div class="cta">
      <div class="flex flex-col gap-3">
        <h2 class="text-[clamp(1.7rem,3.5vw,2.4rem)] text-frost">Let's find the right vending solution for your location.</h2>
        <p class="text-lg text-inverse/80">
          Owned and run by {site.owners} in {site.hometown}.
          {locations.length > 0 && <> Find our machine at {locations.map((l) => `${l.name}, ${l.city}`).join("; ")}.</>}
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 md:items-end">
        <div class="flex flex-wrap gap-3">
          <a href="/host/" class="key key-vend px-7 py-3.5 text-lg">Host a machine</a>
          {site.phone && <a href={`tel:${site.phone}`} class="key key-ghost px-7 py-3.5 text-lg">Call {site.phone}</a>}
        </div>
        {site.email && <a href={`mailto:${site.email}`} class="text-inverse/80 underline hover:text-frost">{site.email}</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(60% 70% at 85% 40%, var(--color-sky-soft), transparent 70%),
      radial-gradient(50% 60% at 10% 0%, var(--color-lime-soft), transparent 70%),
      var(--color-page);
  }
  .eyebrow {
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-lime-dark);
  }
  .photo {
    position: relative;
    display: grid;
    place-items: center;
    padding: 2rem 0;
  }
  .photo-bg {
    position: absolute;
    inset: 0 8%;
    border-radius: 2rem;
    background: linear-gradient(160deg, var(--color-frost), var(--color-sky-soft));
    border: 1px solid var(--color-line);
  }
  .photo img {
    position: relative;
    width: min(62%, 14rem);
    height: auto;
    filter: drop-shadow(0 18px 16px color-mix(in srgb, var(--color-ink) 22%, transparent));
  }
  .badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--color-frost);
    border: 1px solid var(--color-line);
    box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--color-ink) 35%, transparent);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink);
    white-space: nowrap;
    z-index: 1;
  }
  .badge-top {
    top: 14%;
    left: 0;
  }
  .badge-bottom {
    bottom: 12%;
    right: 0;
  }
  .badge-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
  }
  .step-num {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: var(--color-frost);
    border: 2px solid var(--color-lime);
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--color-ink);
    position: relative;
    z-index: 1;
  }
  /* A thin line joining the step numbers on wide screens. */
  @media (min-width: 768px) {
    .steps li:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 1.75rem;
      left: calc(50% + 2.25rem);
      right: calc(-50% + 2.25rem);
      border-top: 2px dashed var(--color-lime);
    }
  }
  .cta {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 1.75rem;
    background:
      radial-gradient(60% 120% at 100% 0%, color-mix(in srgb, var(--color-lime) 22%, transparent), transparent 60%),
      var(--color-cabinet);
  }
  @media (min-width: 768px) {
    .cta {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }
</style>
