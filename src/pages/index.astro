---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import StepArt from "../components/StepArt.astro";
import { cornerstones, locations, promises, site, steps } from "../site";

const tones = {
  orange: "bg-orange-soft text-orange-dark",
  lime: "bg-lime-soft text-lime-dark",
  sky: "bg-sky-soft text-cabinet-2",
  sun: "bg-sun-soft text-orange-dark",
  ink: "bg-ink-soft text-ink",
} as const;
---

<Base>
  <!-- Hero: short pitch on the left, their machine on the right. -->
  <section class="hero">
    <div class="mx-auto grid w-[min(100%-2rem,72rem)] items-center gap-10 pt-10 pb-12 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <div class="flex flex-col items-start gap-6">
        <p class="eyebrow">Family owned. Serving {site.serviceArea}.</p>
        <h1 class="text-[clamp(2.3rem,5vw,3.75rem)] text-ink">A vending machine with more options.</h1>
        <p class="max-w-xl text-xl leading-relaxed text-muted">
          Upgrade your store with a smart fridge full of cold drinks, snacks and healthier picks. Customers tap, grab and go. We stock it and keep it running, and it costs you nothing.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/host/" class="key key-vend px-7 py-3.5 text-lg">Host a machine</a>
          {site.phone && <a href={`tel:${site.phone}`} class="key px-7 py-3.5 text-lg">Call {site.phone}</a>}
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 pt-2 text-sm font-semibold text-ink">
          {
            promises.map((p) => (
              <li class="flex items-center gap-2">
                <span class="grid size-5 place-items-center rounded-full bg-lime text-ink" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                </span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="photo">
        <span class="photo-bg" aria-hidden="true"></span>
        <img src="/machine-photo.png" alt="An Oogum smart vending machine: a black glass-door fridge stocked with drinks and snacks" width="231" height="485" />
        <figcaption class="badge badge-top">
          <span class="badge-dot bg-sky"></span>Tap, grab and go
        </figcaption>
        <p class="badge badge-bottom" aria-hidden="true">
          <span class="badge-dot bg-lime"></span>Family owned and operated
        </p>
      </figure>
    </div>
  </section>

  <!-- Navy break: where we serve. -->
  <div class="bg-cabinet py-4 text-inverse">
    <div class="mx-auto flex w-[min(100%-2rem,72rem)] flex-wrap items-center justify-center gap-x-5 gap-y-2 text-center">
      <span class="text-sm font-bold tracking-[0.12em] text-lime uppercase">Proudly serving</span>
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 font-semibold sm:text-lg">
        {
          site.towns.map((t, i) => (
            <>
              {i > 0 && <li class="size-1.5 rounded-full bg-lime" aria-hidden="true" />}
              <li>{t}</li>
            </>
          ))
        }
        <li class="text-inverse/70">and surrounding areas</li>
      </ul>
    </div>
  </div>

  <!-- The five cornerstones from the flier, as a numbered list beside the heading. -->
  <section class="mx-auto grid w-[min(100%-2rem,72rem)] gap-10 py-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16" aria-labelledby="cornerstones">
    <div class="flex flex-col items-start gap-4 lg:sticky lg:top-8 lg:self-start">
      <p class="eyebrow">Why choose Oogum Vending?</p>
      <h2 id="cornerstones" class="text-[clamp(1.9rem,4vw,2.75rem)] text-ink">The five cornerstones we're built on.</h2>
      <p class="text-lg text-muted">Every machine we place comes with the same promises, from our family to your business.</p>
      <a href="/host/" class="key key-vend mt-2 px-6 py-3">Host a machine</a>
    </div>
    <ol class="stones">
      {
        cornerstones.map((c, i) => (
          <li class="stone">
            <span class="stone-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="flex flex-col gap-1.5">
              <h3 class="text-xl text-ink sm:text-2xl">{c.title}</h3>
              <p class="text-muted">{c.body}</p>
            </div>
            <span class:list={["stone-icon", tones[c.tone]]} aria-hidden="true">
              <Icon name={c.icon} class="size-7" />
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Family owned: Stephen and Nancy. -->
  <section class="bg-tint py-16" aria-labelledby="family">
    <div class="mx-auto grid w-[min(100%-2rem,72rem)] items-center gap-10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-16">
      <figure class="owners">
        <img src="/owners.jpg" alt={`${site.owners} standing beside their Oogum smart vending machine`} width="1000" height="1333" loading="lazy" />
      </figure>
      <div class="flex flex-col items-start gap-5">
        <p class="eyebrow">Family owned and operated</p>
        <h2 id="family" class="text-[clamp(1.9rem,4vw,2.75rem)] text-ink">Meet Stephen and Nancy.</h2>
        <p class="text-lg leading-relaxed text-muted">
          {site.name} is a family business, owned and run by {site.owners} in {site.hometown}. We place the machines, keep them stocked and answer the phone ourselves.
        </p>
        <p class="text-lg leading-relaxed text-muted">
          No call center and no runaround. When you work with us, you work with family, and we treat your spot like our own.
        </p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href="/about/" class="key px-6 py-3">About us</a>
          {site.phone && <a href={`tel:${site.phone}`} class="key key-vend px-6 py-3">Call {site.phone}</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- How a customer buys, with stick-figure drawings. -->
  <section class="mx-auto w-[min(100%-2rem,72rem)] pt-14 pb-4" aria-labelledby="how">
    <div class="flex flex-col items-center gap-2 text-center">
      <p class="eyebrow">How it works</p>
      <h2 id="how" class="text-[clamp(1.6rem,3.5vw,2.25rem)] text-ink">Tap, grab and go.</h2>
    </div>
    <ol class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="flex flex-col items-center gap-2 text-center">
            <StepArt step={i as 0 | 1 | 2} />
            <h3 class="flex items-center gap-2 text-lg text-ink">
              <span class="grid size-7 place-items-center rounded-full bg-lime text-sm">{i + 1}</span>
              {s.title}
            </h3>
            <p class="max-w-xs text-sm text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Call to action. -->
  <section class="mx-auto w-[min(100%-2rem,72rem)] py-14">
    <div class="cta">
      <div class="flex flex-col gap-3">
        <h2 class="text-[clamp(1.7rem,3.5vw,2.4rem)] text-frost">Let's find the right vending solution for your location.</h2>
        <p class="text-lg text-inverse/80">
          Owned and run by {site.owners} in {site.hometown}.
          {locations.length > 0 && <> Find our machine at {locations.map((l) => `${l.name}, ${l.city}`).join("; ")}.</>}
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 md:items-end">
        <div class="flex flex-wrap gap-3">
          <a href="/host/" class="key key-vend px-7 py-3.5 text-lg">Host a machine</a>
          {site.phone && <a href={`tel:${site.phone}`} class="key key-ghost px-7 py-3.5 text-lg">Call {site.phone}</a>}
        </div>
        {site.email && <a href={`mailto:${site.email}`} class="text-inverse/80 underline hover:text-frost">{site.email}</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(60% 70% at 85% 40%, var(--color-sky-soft), transparent 70%),
      radial-gradient(50% 60% at 10% 0%, var(--color-lime-soft), transparent 70%),
      var(--color-page);
  }
  .eyebrow {
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-lime-dark);
  }
  .photo {
    position: relative;
    display: grid;
    place-items: center;
    padding: 2rem 0;
  }
  .photo-bg {
    position: absolute;
    inset: 0 8%;
    border-radius: 2rem;
    background: linear-gradient(160deg, var(--color-frost), var(--color-sky-soft));
    border: 1px solid var(--color-line);
  }
  .photo img {
    position: relative;
    width: min(62%, 14rem);
    height: auto;
    filter: drop-shadow(0 18px 16px color-mix(in srgb, var(--color-ink) 22%, transparent));
  }
  .badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--color-frost);
    border: 1px solid var(--color-line);
    box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--color-ink) 35%, transparent);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink);
    white-space: nowrap;
    z-index: 1;
  }
  .badge-top {
    top: 14%;
    left: 0;
  }
  .badge-bottom {
    bottom: 12%;
    right: 0;
  }
  .badge-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
  }
  .stones {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
  }
  .stone {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 0.25rem;
    border-bottom: 1px solid var(--color-line);
    transition: background-color 150ms;
  }
  .stone:hover {
    background: var(--color-tint);
  }
  .stone-num {
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-lime);
    min-width: 3.5rem;
  }
  .stone-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
  }
  .owners {
    position: relative;
    max-width: 26rem;
    justify-self: center;
  }
  .owners::before {
    content: "";
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border-radius: 1.75rem;
    background: var(--color-lime);
  }
  .owners img {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1.75rem;
    box-shadow: 0 20px 40px -24px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }
  .cta {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 1.75rem;
    background:
      radial-gradient(60% 120% at 100% 0%, color-mix(in srgb, var(--color-lime) 22%, transparent), transparent 60%),
      var(--color-cabinet);
  }
  @media (min-width: 768px) {
    .cta {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }
</style>
