---
import Base from "../layouts/Base.astro";
import Fridge from "../components/Fridge.astro";
import { promises, site } from "../site";
---

<Base>
  <section class="hero mx-auto grid w-[min(100%-2rem,76rem)] items-center gap-8 pt-4 pb-10 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <div class="flex flex-col gap-5">
      <p class="led w-fit px-3 py-1 text-xl uppercase">Smart vending in {site.serviceArea}</p>
      <h1 class="font-sign text-[clamp(2rem,8.5vw,4.5rem)] leading-none text-sun">{site.tagline}</h1>
      <p class="max-w-xl text-xl text-chrome">
        Great choices. Happy people. <span class="text-orange">Better business.</span> We put a smart vending machine in your spot, keep it stocked and running, and it costs you nothing.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/host/" class="key key-vend px-6 py-3 text-lg">Host a machine</a>
        {site.phone && <a href={`tel:${site.phone}`} class="key px-6 py-3 text-lg">Call {site.phone}</a>}
      </div>
    </div>
    <figure class="photo mx-auto">
      <img src="/machine-photo.jpg" alt="An Oogum smart vending machine: a glass-door fridge stocked with drinks and snacks" width="255" height="482" />
      <figcaption>Tap, grab and go</figcaption>
    </figure>
  </section>

  <!-- LED strip with the flier's three promises. -->
  <div class="led mx-auto mb-10 w-[min(100%-2rem,76rem)] overflow-hidden py-2 text-2xl uppercase sm:text-3xl" aria-label={promises.join(". ")}>
    <div class="ticker-run" aria-hidden="true">
      {[0, 1].map(() => promises.map((p) => <span class="px-6">{p} <span class="text-sun">★</span></span>))}
    </div>
  </div>

  <Fridge />

  <section class="mx-auto flex w-[min(100%-2rem,76rem)] flex-col items-center gap-4 pb-12 text-center">
    <p class="text-2xl text-frost">Let's find the right vending solution for your location.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/host/" class="key key-vend px-6 py-3">Host a machine</a>
      {site.phone && <a href={`tel:${site.phone}`} class="key px-6 py-3">Call {site.phone}</a>}
    </div>
    {site.email && <a href={`mailto:${site.email}`} class="text-chrome underline">{site.email}</a>}
  </section>
</Base>

<style>
  .photo {
    position: relative;
    width: min(100%, 17rem);
  }
  .photo img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 4px solid var(--color-chrome);
    box-shadow:
      10px 10px 0 var(--color-lime),
      0 0 50px rgb(127 211 245 / 0.35);
  }
  .photo figcaption {
    position: absolute;
    left: -1.25rem;
    bottom: 1.5rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-orange);
    color: var(--color-frost);
    font-family: var(--font-display);
    border-radius: 0.5rem;
    transform: rotate(-4deg);
    box-shadow: 4px 4px 0 var(--color-floor);
  }
  .ticker-run {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: run 22s linear infinite;
  }
  @keyframes run {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-run {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }
  }
</style>
