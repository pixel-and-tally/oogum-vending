---
import Base from "../layouts/Base.astro";
import Machine from "../components/Machine.astro";
import { site } from "../site";
---

<Base>
  <Machine />
  <section class="mx-auto w-full max-w-3xl px-4 pb-12 text-center sm:px-6">
    <h2 class="text-2xl text-frost sm:text-3xl">{site.name}</h2>
    <p class="mt-3 text-lg text-chrome">{site.description}</p>
    <a href="/host/" class="key key-vend mt-6 inline-block px-6 py-3">Host a machine</a>
  </section>
</Base>
