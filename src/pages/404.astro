---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" noindex>
  <section class="mx-auto flex w-full max-w-2xl flex-col items-start gap-6 px-4 py-20 sm:px-6">
    <p class="led px-3 py-1 text-2xl uppercase">Error: slot empty</p>
    <h1 class="text-4xl text-frost sm:text-5xl">Nothing in this coil.</h1>
    <a href="/" class="key px-5 py-3">Back to the machine</a>
  </section>
</Base>
