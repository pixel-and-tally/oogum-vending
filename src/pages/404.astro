---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" noindex>
  <section class="mx-auto flex w-full max-w-2xl flex-col items-start gap-6 px-4 py-20 sm:px-6">
    <p class="rounded-full bg-lime-soft px-4 py-1 font-semibold text-lime-dark">Page not found</p>
    <h1 class="text-4xl text-ink sm:text-5xl">This shelf is empty.</h1>
    <a href="/" class="key px-5 py-3">Back to the machine</a>
  </section>
</Base>
