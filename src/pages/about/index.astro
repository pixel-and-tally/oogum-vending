---
import Base from "../../layouts/Base.astro";
import { family, locations, site } from "../../site";

// Facts only, from the owners and their flier. Owner bios stay hidden until Stephen and Nancy write them.
const bios = family.owners.filter((o) => o.bio);
---

<Base title="About us, a family business in Belmont, NC" description={`${site.name} is a family-owned business that delivers personalized attention. Owned and run by ${site.owners} in ${site.hometown}. Refrigerated smart AI vending machines, stocked and serviced at no cost to the host.`}>
  <!-- Meet the family. -->
  <section class="mx-auto grid w-[min(100%-2rem,72rem)] items-center gap-10 pt-10 pb-16 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:gap-14">
    <div class="flex flex-col items-start gap-5">
      <p class="label">Meet the family behind the machines</p>
      <h1 class="about-title text-ink">A family-owned business that delivers <span class="mark">personalized attention</span>.</h1>
      <p class="max-w-xl text-lg leading-relaxed text-muted">
        We're {site.owners}, and {site.name} is our family business in {site.hometown}. We put refrigerated smart AI vending machines in local businesses, then stock, watch and look after every one of them ourselves.
      </p>
      <p class="max-w-xl text-lg leading-relaxed text-muted">
        We stay small on purpose. It means we know every spot we serve, and every person who calls us gets one of us.
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a href="/host/" class="key key-vend px-6 py-3 text-lg">{site.cta}</a>
        {site.phone && <a href={`tel:${site.phone}`} class="key px-6 py-3 text-lg">Call {site.phone}</a>}
      </div>
    </div>
    <figure class="owners">
      <img src="/owners.jpg" alt={`${site.owners} standing beside their Oogum smart vending machine`} width="1000" height="1333" />
      <figcaption>{site.owners}, {site.hometown}</figcaption>
    </figure>
  </section>

  {
    bios.length > 0 && (
      <section class="mx-auto grid w-[min(100%-2rem,72rem)] gap-6 pb-16 sm:grid-cols-2" aria-label="The owners">
        {bios.map((o) => (
          <div class="bio">
            <h2 class="text-2xl text-ink">{o.name}</h2>
            <p class="text-lg leading-relaxed text-muted">{o.bio}</p>
          </div>
        ))}
      </section>
    )
  }

  <!-- What personalized attention means here. -->
  <section class="bg-paper py-16" aria-labelledby="attention">
    <div class="mx-auto w-[min(100%-2rem,72rem)]">
      <p class="label">Personalized attention</p>
      <h2 id="attention" class="mt-3 max-w-2xl text-[clamp(1.8rem,3.8vw,2.6rem)] text-ink">We treat your spot like our own.</h2>
      <ol class="attention mt-10">
        {
          family.attention.map((a, i) => (
            <li>
              <span class="attention-num" aria-hidden="true">0{i + 1}</span>
              <h3 class="text-xl text-ink">{a.title}</h3>
              <p class="text-muted">{a.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- One thing, done well. -->
  <section class="mx-auto grid w-[min(100%-2rem,72rem)] gap-10 py-16 md:grid-cols-2 md:gap-14">
    <div class="flex flex-col gap-4">
      <p class="label">What we do</p>
      <h2 class="text-[clamp(1.7rem,3.5vw,2.4rem)] text-ink">Smart AI vending. That's it, and that's the point.</h2>
      <p class="text-lg leading-relaxed text-muted">
        Every Oogum machine is a refrigerated glass-door smart machine. Customers tap a card or phone, the door unlocks, they grab what they want and checkout happens on its own. The machine keeps count of its stock and alerts us when something runs low.
      </p>
      <p class="text-lg leading-relaxed text-muted">
        It's a vending machine with more options: cold drinks, popular snacks and healthier picks, all in one place. It costs the host nothing.
      </p>
    </div>
    <div class="flex flex-col gap-6">
      {
        locations.length > 0 && (
          <div class="rounded-card border-2 border-line p-6">
            <h2 class="text-xl text-ink">Find our machine</h2>
            <ul class="mt-2 flex flex-col gap-1 text-muted">
              {locations.map((l) => (
                <li>
                  {l.name}, {l.city}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="rounded-card border-2 border-line p-6">
        <h2 class="text-xl text-ink">Get in touch</h2>
        <ul class="mt-2 flex flex-col gap-1">
          {site.phone && <li><a class="underline" href={`tel:${site.phone}`}>{site.phone}</a></li>}
          {site.email && <li><a class="underline" href={`mailto:${site.email}`}>{site.email}</a></li>}
          <li class="text-muted">Serving {site.serviceArea}: {site.towns.join(", ")} and nearby.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- A short note from the owners. -->
  <section class="mx-auto w-[min(100%-2rem,48rem)] pb-16 text-center">
    <p class="text-[clamp(1.4rem,3vw,1.9rem)] font-bold leading-snug text-ink">
      "Thanks for looking us up. If you've got a spot in mind, give us a call. One of us will pick up, and we'd love to meet you."
    </p>
    <p class="mt-4 text-lg font-semibold text-lime-dark">Stephen and Nancy</p>
  </section>

  <!-- Closing ask. -->
  <section class="mx-auto w-[min(100%-2rem,72rem)] pb-16">
    <div class="cta">
      <div class="flex flex-col gap-2">
        <h2 class="text-[clamp(1.6rem,3.2vw,2.2rem)] text-frost">Want to meet the family in person?</h2>
        <p class="text-lg text-inverse/80">Tell us about your location and we'll come take a look. Free install, nothing to pay.</p>
      </div>
      <a href="/host/" class="key key-vend px-7 py-3.5 text-lg md:justify-self-end">{site.cta}</a>
    </div>
  </section>
</Base>

<style>
  .label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    color: var(--color-lime-dark);
  }
  .about-title {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 1.08;
  }
  .mark {
    text-decoration: underline;
    text-decoration-color: var(--color-lime);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.14em;
  }
  .owners {
    max-width: 28rem;
    justify-self: center;
  }
  .owners img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-control);
  }
  .owners figcaption {
    margin-top: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .attention {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .attention li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .attention-num {
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-lime-dark);
  }
  .cta {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: var(--radius-control);
    background: var(--color-cabinet);
  }
  @media (min-width: 768px) {
    .cta {
      grid-template-columns: minmax(0, 1.4fr) auto;
    }
  }
</style>
