---
import Hub from "../../layouts/Hub.astro";
import type { HostRequest } from "../../lib/host";
import { bestPrices, type PriceEntry } from "../../lib/prices";
import { getStore } from "../../lib/store";
import { locations } from "../../site";

export const prerender = false;

const store = await getStore();
const [requests, prices] = await Promise.all([store.read<HostRequest>("requests"), store.read<PriceEntry>("prices")]);
const open = requests.filter((r) => r.stage !== "Signed" && r.stage !== "Not a fit");
const fresh = requests.filter((r) => r.stage === "New");
const user = Astro.locals.user ?? "";

const tiles = [
  { href: "/hub/machines/", label: "Machines", value: String(locations.length), note: "Stock data not connected yet" },
  { href: "/hub/requests/", label: "Open host requests", value: String(open.length), note: fresh.length ? `${fresh.length} new, not called yet` : "Nothing new" },
  { href: "/hub/prices/", label: "Items price-tracked", value: String(bestPrices(prices).length), note: `${prices.length} prices logged` },
];
---

<Hub title="Overview">
  <h1 class="text-3xl">Hi {user ? user[0].toUpperCase() + user.slice(1) : "there"}.</h1>
  <ul class="grid gap-4 sm:grid-cols-3">
    {
      tiles.map((t) => (
        <li>
          <a href={t.href} class="flex h-full flex-col gap-1 rounded-card border-2 border-line bg-frost p-5 hover:border-cabinet">
            <span class="text-sm font-semibold text-muted">{t.label}</span>
            <span class="font-led text-5xl leading-none">{t.value}</span>
            <span class="text-sm text-muted">{t.note}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Hub>
