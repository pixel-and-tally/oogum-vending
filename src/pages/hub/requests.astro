---
import Hub from "../../layouts/Hub.astro";
import { callLabel, type HostRequest } from "../../lib/host";
import { getStore } from "../../lib/store";
import { requestStages, type RequestStage } from "../../site";

export const prerender = false;

const store = await getStore();

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = String(form.get("id") ?? "");
  const stage = String(form.get("stage") ?? "") as RequestStage;
  const rows = await store.read<HostRequest>("requests");
  const row = rows.find((r) => r.id === id);
  if (row && requestStages.includes(stage)) {
    row.stage = stage;
    row.notes = String(form.get("notes") ?? "").slice(0, 2000);
    await store.write("requests", rows);
  }
  return Astro.redirect(`/hub/requests/#r-${id}`, 303);
}

const rows = await store.read<HostRequest>("requests");
const filter = Astro.url.searchParams.get("stage") ?? "";
const shown = filter ? rows.filter((r) => r.stage === filter) : rows;
const count = (s: RequestStage) => rows.filter((r) => r.stage === s).length;
const when = (iso: string) =>
  new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "short", timeZone: "America/New_York" }).format(new Date(iso));
const control = "w-full rounded-control border-2 border-line bg-frost px-3 py-2 outline-none focus:border-cabinet";
---

<Hub title="Host requests">
  <div>
    <h1 class="text-3xl">Host requests</h1>
    <p class="mt-2 max-w-2xl text-muted">Every "Host a machine" form lands here and in your email. Move each one along as you call and visit.</p>
  </div>

  <nav class="flex flex-wrap gap-2" aria-label="Filter by stage">
    <a href="/hub/requests/" aria-current={!filter ? "page" : undefined} class="rounded-full border-2 border-line px-3 py-1 text-sm aria-[current=page]:border-ink aria-[current=page]:bg-sky">All {rows.length}</a>
    {
      requestStages.map((s) => (
        <a href={`/hub/requests/?stage=${encodeURIComponent(s)}`} aria-current={filter === s ? "page" : undefined} class="rounded-full border-2 border-line px-3 py-1 text-sm aria-[current=page]:border-ink aria-[current=page]:bg-sky">
          {s} {count(s)}
        </a>
      ))
    }
  </nav>

  {
    shown.length === 0 ? (
      <p class="rounded-card border-2 border-dashed border-line p-6 text-muted">
        {rows.length === 0 ? "No requests yet. They show up here as soon as a store sends the form on the Host a machine page." : "Nothing at this stage."}
      </p>
    ) : (
      <ul class="flex flex-col gap-4">
        {shown.map((r) => (
          <li id={`r-${r.id}`} class="scroll-mt-6 rounded-card border-2 border-line bg-frost p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="font-display text-lg">{r.business}</p>
                <p class="text-sm text-muted">{r.address}</p>
              </div>
              <span class="rounded bg-sun px-2 py-0.5 text-sm font-semibold">{r.stage}</span>
            </div>
            <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-4">
              <div><dt class="text-muted">Contact</dt><dd>{r.name}, {r.role}</dd></div>
              <div><dt class="text-muted">Phone</dt><dd><a class="underline" href={`tel:${r.phone}`}>{r.phone}</a></dd></div>
              <div><dt class="text-muted">Email</dt><dd><a class="underline" href={`mailto:${r.email}`}>{r.email}</a></dd></div>
              <div><dt class="text-muted">Customers a day</dt><dd>{r.traffic}</dd></div>
              <div><dt class="text-muted">Received</dt><dd>{when(r.receivedAt)}</dd></div>
              <div><dt class="text-muted">Call requested</dt><dd>{callLabel(r) || "None"}</dd></div>
            </dl>
            {r.details && <p class="mt-3 rounded-control bg-glass p-3 text-sm">{r.details}</p>}
            <form method="POST" class="mt-4 grid gap-3 sm:grid-cols-[12rem_1fr_auto] sm:items-end">
              <input type="hidden" name="id" value={r.id} />
              <div class="flex flex-col gap-1">
                <label for={`stage-${r.id}`} class="text-sm font-bold">Stage</label>
                <select id={`stage-${r.id}`} name="stage" autocomplete="off" class={control}>
                  {requestStages.map((s) => <option selected={s === r.stage}>{s}</option>)}
                </select>
              </div>
              <div class="flex flex-col gap-1">
                <label for={`notes-${r.id}`} class="text-sm font-bold">Notes</label>
                <input id={`notes-${r.id}`} name="notes" autocomplete="off" value={r.notes} placeholder="Spoke to manager, visit Tuesday" class={control} />
              </div>
              <button class="key px-5 py-2.5">Save</button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
</Hub>
