---
// Posts to /api/host. Call picker and error handling follow the Pixel & Tally
// contact form: inline errors, focus the first bad field, a form-level message.
// Without JavaScript the browser validates, the call picker is skipped, and the
// endpoint redirects.
import { honeypotField, trafficOptions } from "../lib/host";
import { availability, site } from "../site";

const fields = [
  { id: "name", label: "Your name", type: "text", autocomplete: "name", error: "Tell us your name." },
  { id: "role", label: "Your role", type: "text", autocomplete: "organization-title", error: "Store manager, owner, something else?", placeholder: "Store manager" },
  { id: "email", label: "Email", type: "email", autocomplete: "email", error: "Enter an email we can reply to." },
  { id: "phone", label: "Phone", type: "tel", autocomplete: "tel", error: "Enter a phone number with area code." },
  { id: "business", label: "Business name", type: "text", autocomplete: "organization", error: "Which business is this for?", placeholder: "Firestone Complete Auto Care" },
  { id: "address", label: "Store address", type: "text", autocomplete: "street-address", error: "Tell us where the store is.", placeholder: "Street, city, NC" },
] as const;

const control =
  "w-full rounded-control border-2 border-line bg-frost px-4 py-3 text-base text-ink outline-none focus:border-cabinet focus:ring-4 focus:ring-sky/40 aria-[invalid=true]:border-danger aria-[invalid=true]:bg-danger/5";
const chip =
  "relative cursor-pointer rounded-control border-2 border-line bg-frost px-3 py-2 font-led text-xl leading-none whitespace-nowrap text-ink has-[:checked]:border-ink has-[:checked]:bg-lime has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-sun";
const sendFailed = site.phone
  ? `That didn't send. Try again in a minute, or call us at ${site.phone}.`
  : "That didn't send. Try again in a minute.";
---

<form id="request" method="POST" action="/api/host" novalidate class="flex flex-col gap-8 rounded-card bg-paper p-5 text-ink sm:p-8" data-host-form data-send-failed={sendFailed}>
  <p class="hidden" aria-hidden="true">
    <label>Leave this empty: <input name={honeypotField} tabindex="-1" autocomplete="off" /></label>
  </p>

  <div data-form-error role="alert" tabindex="-1" hidden class="rounded-control border-2 border-danger bg-danger/5 px-4 py-3 font-semibold text-danger"></div>

  <fieldset class="flex min-w-0 flex-col gap-5">
    <legend class="mb-2 font-display text-2xl">1. About the store</legend>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        fields.map((f) => (
          <div class="flex flex-col gap-1.5">
            <label for={f.id} class="text-sm font-bold">{f.label}</label>
            <input
              id={f.id}
              name={f.id}
              type={f.type}
              autocomplete={f.autocomplete}
              required
              placeholder={"placeholder" in f ? f.placeholder : undefined}
              data-error={f.error}
              aria-describedby={`${f.id}-error`}
              class={control}
            />
            <p id={`${f.id}-error`} class="text-sm font-semibold text-danger" hidden />
          </div>
        ))
      }
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="traffic" class="text-sm font-bold">About how many customers come through a day?</label>
      <select id="traffic" name="traffic" required autocomplete="off" data-error="Pick the closest one. Not sure is fine." aria-describedby="traffic-error" class={control}>
        <option value="">Choose one</option>
        {trafficOptions.map((t) => <option value={t}>{t}</option>)}
      </select>
      <p id="traffic-error" class="text-sm font-semibold text-danger" hidden></p>
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="details" class="text-sm font-bold">Anything else? <span class="font-normal text-muted">(optional)</span></label>
      <textarea id="details" name="details" rows="4" autocomplete="off" class={control} placeholder="Where it could go, outlet nearby, hours, questions."></textarea>
    </div>
  </fieldset>

  <fieldset class="flex min-w-0 flex-col gap-4" data-call-picker data-availability={JSON.stringify(availability)}>
    <legend class="mb-2 font-display text-2xl">2. Pick a time to talk <span class="font-body text-base text-muted">(optional)</span></legend>
    <p class="text-sm text-muted">A {availability.callMinutes}-minute call, Eastern time. We'll confirm by email. Skip this and we'll call you.</p>
    <noscript><p class="text-sm">Turn on JavaScript to pick a time, or just send this and we'll reach out.</p></noscript>
    <div>
      <p id="day-label" class="mb-2 text-sm font-bold">Day</p>
      <div role="radiogroup" aria-labelledby="day-label" class="-mx-1 flex gap-2 overflow-x-auto px-1 pt-1 pb-2" data-days></div>
    </div>
    <div data-times-wrap hidden>
      <p id="time-label" class="mb-2 text-sm font-bold">Time (Eastern)</p>
      <div role="radiogroup" aria-labelledby="time-label" aria-describedby="callTime-error" class="flex flex-wrap gap-2 pt-1" tabindex="-1" data-times></div>
      <p id="callTime-error" class="mt-2 text-sm font-semibold text-danger" hidden></p>
    </div>
    <button type="button" data-clear-call hidden class="w-fit text-sm underline">Clear the time</button>
  </fieldset>

  <div class="flex flex-col gap-2">
    <button type="submit" data-submit class="key key-vend w-full px-8 py-4 text-xl disabled:opacity-60 sm:w-fit">Send request</button>
    <p class="text-xs text-muted">We only use your details to reply about a machine.</p>
  </div>
</form>

<template id="chip-template">
  <label class={chip}><input type="radio" class="sr-only" /><span></span></label>
</template>

<script>
  import { availableTimes, bookableDates, formatTime, type Availability } from "../lib/schedule";

  const form = document.querySelector<HTMLFormElement>("[data-host-form]");
  if (form) {
    const sendFailed = form.dataset.sendFailed!;
    const summary = form.querySelector<HTMLElement>("[data-form-error]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]"));

    const picker = form.querySelector<HTMLElement>("[data-call-picker]")!;
    const cfg = JSON.parse(picker.dataset.availability!) as Availability;
    const daysEl = picker.querySelector<HTMLElement>("[data-days]")!;
    const timesWrap = picker.querySelector<HTMLElement>("[data-times-wrap]")!;
    const timesEl = picker.querySelector<HTMLElement>("[data-times]")!;
    const timeError = picker.querySelector<HTMLElement>("#callTime-error")!;
    const clear = picker.querySelector<HTMLButtonElement>("[data-clear-call]")!;
    const template = document.querySelector<HTMLTemplateElement>("#chip-template")!;

    const makeChip = (name: string, value: string, label: string) => {
      const node = template.content.firstElementChild!.cloneNode(true) as HTMLLabelElement;
      const input = node.querySelector("input")!;
      input.name = name;
      input.value = value;
      node.querySelector("span")!.textContent = label;
      return { node, input };
    };
    const dayLabel = (date: string) =>
      new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
    const setTimeError = (msg: string) => {
      timeError.textContent = msg;
      timeError.hidden = !msg;
    };
    const showTimes = (date: string) => {
      timesEl.replaceChildren();
      for (const t of availableTimes(date, cfg, new Date())) {
        const { node, input } = makeChip("callTime", t, formatTime(t));
        input.addEventListener("change", () => setTimeError(""));
        timesEl.append(node);
      }
      timesWrap.hidden = false;
      clear.hidden = false;
    };

    const dates = bookableDates(cfg, new Date());
    if (dates.length === 0) daysEl.textContent = "No open times in the next two weeks. Send this and we'll call you.";
    for (const d of dates) {
      const { node, input } = makeChip("callDate", d, dayLabel(d));
      input.addEventListener("change", () => {
        setTimeError("");
        showTimes(d);
      });
      daysEl.append(node);
    }
    clear.addEventListener("click", () => {
      picker.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((r) => (r.checked = false));
      timesEl.replaceChildren();
      timesWrap.hidden = true;
      clear.hidden = true;
      setTimeError("");
    });
    const callIsValid = () => {
      const day = picker.querySelector("input[name=callDate]:checked");
      const time = picker.querySelector("input[name=callTime]:checked");
      if (day && !time) {
        setTimeError("Pick a time for that day, or clear it.");
        return false;
      }
      return true;
    };

    const show = (el: (typeof controls)[number]) => {
      const msg = document.getElementById(`${el.id}-error`);
      const bad = !el.checkValidity();
      el.setAttribute("aria-invalid", String(bad));
      if (msg) {
        msg.textContent = bad ? (el.dataset.error ?? "Check this field.") : "";
        msg.hidden = !bad;
      }
      return bad;
    };
    controls.forEach((el) => {
      el.addEventListener("blur", () => el.value && show(el));
      el.addEventListener("input", () => el.getAttribute("aria-invalid") === "true" && show(el));
    });
    const showSummary = (text: string, focus: HTMLElement) => {
      summary.textContent = text;
      summary.hidden = false;
      focus.focus();
      focus.scrollIntoView({ block: "center", behavior: "smooth" });
    };
    if (new URLSearchParams(location.search).has("error")) {
      summary.textContent = sendFailed;
      summary.hidden = false;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const callOk = callIsValid();
      const bad = controls.filter(show);
      if (!callOk || bad.length) {
        const n = bad.length + (callOk ? 0 : 1);
        showSummary(n === 1 ? "One thing needs a fix before this can send." : `${n} things need a fix before this can send.`, bad[0] ?? timesEl);
        return;
      }
      summary.hidden = true;
      button.disabled = true;
      button.textContent = "Sending...";
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        if (res.ok) {
          location.href = "/host/thanks/";
          return;
        }
        const body = (await res.json().catch(() => ({}))) as { invalid?: string[] };
        if (body.invalid?.includes("callTime")) {
          setTimeError("That time just closed. Pick another one.");
          const day = picker.querySelector<HTMLInputElement>("input[name=callDate]:checked");
          if (day) showTimes(day.value);
          showSummary("That time is no longer open.", timesEl);
          return;
        }
        const firstBad = body.invalid?.map((id) => controls.find((c) => c.id === id)).find(Boolean);
        if (firstBad) {
          body.invalid!.forEach((id) => {
            const c = controls.find((el) => el.id === id);
            if (c) show(c);
          });
          showSummary("Something in the form needs a fix before this can send.", firstBad);
        } else showSummary(sendFailed, summary);
      } catch {
        showSummary(sendFailed, summary);
      } finally {
        button.disabled = false;
        button.textContent = "Send request";
      }
    });
  }
</script>
