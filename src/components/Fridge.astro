---
// The home page's main piece: a big glass-door smart fridge, like Oogum's real
// machines. The cards on its shelves are the site's main points.
import { cards, locations, site } from "../site";

const rows = ["A", "B", "C", "D"];
const code = (i: number) => `${rows[Math.floor(i / 3)]}${(i % 3) + 1}`;
const steps = ["Swipe / Tap", "Grab items", "Auto checkout"];
---

<section class="fridge-wrap" aria-labelledby="why">
  <div class="fridge">
    <header class="sign">
      {site.logo ? <img src={site.logo} alt={site.name} class="sign-logo" /> : <span class="font-sign text-4xl text-ink">{site.name}</span>}
      <h2 id="why" class="sign-title">Why choose {site.name}?</h2>
    </header>

    <div class="body">
      <aside class="side" aria-label="How to buy">
        <div class="reader" aria-hidden="true">
          <span class="reader-waves">)))</span>
          <span>Tap here</span>
        </div>
        <ol class="steps">
          {steps.map((s) => <li>{s}</li>)}
        </ol>
        <a href="/host/" class="side-sticker">Host a machine</a>
      </aside>

      <div class="door">
        <span class="lightbar" aria-hidden="true"></span>
        <ul class="shelves">
          {
            cards.map((c, i) => (
              <li class="card" style={`--tone: var(--color-${c.tone})`}>
                <span class="card-code">{code(i)}</span>
                <h3 class="card-title">{c.title}</h3>
                <p class="card-body">{c.body}</p>
                {c.showLocations && (
                  <ul class="mt-2 flex flex-col gap-1">
                    {locations.map((l) => (
                      <li class="font-display text-lg">
                        {l.name}, {l.city}
                      </li>
                    ))}
                  </ul>
                )}
                {c.link && (
                  <a href={c.link.href} class="card-link">
                    {c.link.label} →
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        <span class="handle" aria-hidden="true"></span>
      </div>
    </div>

    <div class="grille" aria-hidden="true"></div>
  </div>
  <div class="feet" aria-hidden="true"><span></span><span></span></div>
</section>

<style>
  .fridge-wrap {
    width: min(100% - 2rem, 76rem);
    margin: 0 auto 3rem;
  }
  .fridge {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.05), transparent 10%, transparent 90%, rgb(0 0 0 / 0.3)),
      var(--color-cabinet);
    border: 5px solid var(--color-chrome-dark);
    border-radius: 1.5rem;
    padding: clamp(0.6rem, 1.5vw, 1rem);
    box-shadow:
      inset 0 0 0 3px var(--color-cabinet-2),
      0 30px 60px -20px rgb(0 0 0 / 0.8);
  }

  /* Lit sign across the top. */
  .sign {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-frost);
    border-radius: 1rem;
    padding: 0.5rem 1.25rem;
    box-shadow: 0 0 28px rgb(127 211 245 / 0.35);
  }
  .sign-logo {
    height: clamp(3.5rem, 8vw, 5.5rem);
    width: auto;
  }
  .sign-title {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: clamp(1.1rem, 2.6vw, 2rem);
    text-align: right;
    line-height: 1.1;
  }

  .body {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: clamp(0.6rem, 1.5vw, 1rem);
    margin-top: clamp(0.6rem, 1.5vw, 1rem);
  }

  /* The side panel, like the decal on the real machine. */
  .side {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    padding: 1rem 0.75rem;
    border: 3px solid var(--color-cabinet-2);
    border-radius: 1rem;
  }
  .reader {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.5rem;
    background: var(--color-led-bg);
    border: 3px solid var(--color-chrome-dark);
    border-radius: 0.75rem;
    color: var(--color-led);
    font-family: var(--font-led);
    font-size: 1.3rem;
    text-shadow: 0 0 6px rgb(109 255 138 / 0.8);
  }
  .reader-waves {
    font-size: 1.8rem;
    line-height: 1;
    transform: rotate(-90deg);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding: 0.5rem 0.4rem;
    border: 2px solid var(--color-chrome);
    border-radius: 0.5rem;
    color: var(--color-frost);
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-align: center;
  }
  .steps li + li::before {
    content: "▼";
    position: absolute;
    top: -1.3rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-chrome);
    font-size: 0.8rem;
  }
  .side-sticker {
    margin-top: auto;
    padding: 0.75rem 0.5rem;
    background: var(--color-orange);
    color: var(--color-frost);
    border-radius: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    text-align: center;
    transform: rotate(-3deg);
    box-shadow: 4px 4px 0 var(--color-floor);
  }
  .side-sticker:hover {
    transform: rotate(0deg) scale(1.04);
  }

  /* The glass door: lit inside, chrome frame, a handle on the right. */
  .door {
    position: relative;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 1.75rem) clamp(0.75rem, 2vw, 1.75rem);
    background:
      linear-gradient(105deg, transparent 20%, rgb(255 255 255 / 0.35) 24%, transparent 30%),
      radial-gradient(120% 90% at 50% 0%, var(--color-frost), var(--color-glass) 55%, var(--color-cold));
    border: 6px solid var(--color-chrome);
    border-radius: 1rem;
    box-shadow:
      inset 0 0 0 2px var(--color-chrome-dark),
      inset 0 0 50px rgb(127 211 245 / 0.6);
  }
  .lightbar {
    position: absolute;
    top: 0.4rem;
    left: 8%;
    right: 8%;
    height: 5px;
    border-radius: 999px;
    background: var(--color-frost);
    box-shadow: 0 0 18px 6px rgb(255 255 255 / 0.9);
  }
  .handle {
    position: absolute;
    right: 0.45rem;
    top: 18%;
    bottom: 18%;
    width: 9px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-chrome-dark), var(--color-frost), var(--color-chrome-dark));
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.4);
  }

  /* Shelves: three cards per row, each row standing on a chrome lip. */
  .shelves {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 1.8vw, 1.25rem);
    row-gap: clamp(2rem, 4vw, 2.75rem);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.1rem 1.2rem;
    background: var(--tone);
    color: var(--color-ink);
    border: 3px solid var(--color-ink);
    border-radius: 0.9rem;
    box-shadow: 6px 6px 0 var(--color-ink);
    transition: transform 160ms, box-shadow 160ms;
  }
  /* The shelf lip under each card. */
  .card::after {
    content: "";
    position: absolute;
    left: -0.75rem;
    right: -0.75rem;
    bottom: calc(-0.9rem - 6px);
    height: 7px;
    border-radius: 3px;
    background: var(--color-chrome-dark);
    box-shadow: 0 3px 0 rgb(1 32 76 / 0.25);
    transition: transform 160ms;
  }
  .card:hover {
    transform: translate(-3px, -6px) rotate(-1deg);
    box-shadow: 9px 12px 0 var(--color-ink);
  }
  .card:hover::after {
    transform: translate(3px, 6px) rotate(1deg);
  }
  .card-code {
    align-self: flex-start;
    padding: 0.1rem 0.45rem;
    background: var(--color-frost);
    border: 2px solid var(--color-ink);
    border-radius: 0.3rem;
    font-family: var(--font-led);
    font-size: 1.2rem;
    line-height: 1.1;
  }
  .card-title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.9rem);
    line-height: 1.05;
  }
  .card-body {
    margin-top: 0.5rem;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .card-link {
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-display);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .grille {
    height: 2.25rem;
    margin-top: clamp(0.6rem, 1.5vw, 1rem);
    border-radius: 0.6rem;
    background: repeating-linear-gradient(var(--color-floor) 0 4px, var(--color-cabinet-2) 4px 8px);
    border: 3px solid var(--color-cabinet-2);
  }
  .feet {
    display: flex;
    justify-content: space-between;
    padding: 0 8%;
  }
  .feet span {
    width: 2.5rem;
    height: 0.8rem;
    border-radius: 0 0 0.5rem 0.5rem;
    background: var(--color-chrome-dark);
  }

  @media (max-width: 60rem) {
    .shelves {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 44rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      padding: 0.6rem;
    }
    .reader {
      flex-direction: row;
      padding: 0.4rem 0.6rem;
    }
    .steps {
      flex-direction: row;
      gap: 0.4rem;
      flex: 1;
    }
    .steps li {
      flex: 1;
      font-size: 0.65rem;
      padding: 0.4rem 0.2rem;
    }
    .steps li + li::before {
      display: none;
    }
    .side-sticker {
      display: none;
    }
    .shelves {
      grid-template-columns: minmax(0, 1fr);
    }
    .sign {
      flex-direction: column;
      text-align: center;
    }
    .sign-title {
      text-align: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reader-waves {
      animation: none;
    }
    .card,
    .card::after {
      transition: none;
    }
  }
</style>
