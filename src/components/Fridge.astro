---
// The home page's main piece: a black double-door smart fridge, like Oogum's real
// machines. The main points sit on its shelves as cards, all the same size.
import { cards, locations, site } from "../site";

const perDoor = Math.ceil(cards.length / 2);
const doors = [cards.slice(0, perDoor), cards.slice(perDoor)];
const rows = ["A", "B", "C", "D"];
// Row letter, then column across the whole machine (two columns per door).
const code = (door: number, i: number) => `${rows[Math.floor(i / 2)]}${door * 2 + (i % 2) + 1}`;
---

<section class="wrap" aria-labelledby="why">
  <h2 id="why" class="mb-6 text-center text-3xl text-ink sm:text-5xl">
    Why choose <span class="text-lime-dark">{site.name}</span>?
  </h2>

  <div class="machine">
    <header class="topper">
      <div class="plate">
        {site.logo ? <img src={site.logo} alt="" class="plate-logo" /> : <span class="font-display text-3xl text-ink">{site.name}</span>}
      </div>
      <p class="topper-text">Smart<br />vending</p>
      <div class="reader" aria-hidden="true">
        <span class="reader-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M8.5 7.5a6 6 0 0 1 0 9M12 5a9.5 9.5 0 0 1 0 14M5 10a2.5 2.5 0 0 1 0 4" />
          </svg>
        </span>
        <span>Tap to unlock</span>
      </div>
      <span class="glow" aria-hidden="true"></span>
    </header>

    <div class="doors">
      {
        doors.map((list, d) => (
          <div class:list={["door", d === 0 ? "door-left" : "door-right"]}>
            {list.map((c, i) => (
              <article class="slot" style={`--tone: var(--color-${c.tone})`}>
                <div class="card">
                  <h3 class="card-title">{c.title}</h3>
                  <p class="card-body">{c.body}</p>
                  {c.showLocations && (
                    <ul class="mt-1">
                      {locations.map((l) => (
                        <li class="font-display text-lg font-semibold uppercase">
                          {l.name}, {l.city}
                        </li>
                      ))}
                    </ul>
                  )}
                  {c.link && (
                    <a href={c.link.href} class="card-link">
                      {c.link.label} →
                    </a>
                  )}
                </div>
                <div class="rail">
                  <span class="tag">{code(d, i)}</span>
                </div>
              </article>
            ))}
            <span class="handle" aria-hidden="true"></span>
          </div>
        ))
      }
    </div>

    <div class="kick" aria-hidden="true">
      <span class="vent"></span>
      <span class="badge">{site.name}</span>
    </div>
  </div>
  <div class="casters" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</section>

<style>
  .wrap {
    width: min(100% - 2rem, 72rem);
    margin: 0 auto 4rem;
  }

  /* Black cabinet with a slight sheen, like the real machine. */
  .machine {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.08), transparent 6%, transparent 94%, rgb(255 255 255 / 0.05)),
      var(--color-machine);
    border-radius: 1.25rem 1.25rem 0.75rem 0.75rem;
    padding: 0 clamp(0.5rem, 1.4vw, 1rem);
    box-shadow:
      inset 0 0 0 2px var(--color-machine-2),
      0 40px 50px -30px rgb(1 32 76 / 0.55);
  }

  /* Topper: lit logo plate, "Smart vending", card reader. */
  .topper {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding: clamp(0.75rem, 1.6vw, 1.1rem) clamp(0.25rem, 1vw, 0.5rem);
  }
  .plate {
    background: var(--color-frost);
    border-radius: 0.75rem;
    padding: 0.25rem 0.9rem;
    box-shadow: 0 0 24px rgb(255 255 255 / 0.25);
  }
  .plate-logo {
    height: clamp(3rem, 6.5vw, 4.75rem);
    width: auto;
  }
  .topper-text {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-frost);
    font-size: clamp(1rem, 2.2vw, 1.6rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .reader {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    background: var(--color-machine-2);
    border: 2px solid var(--color-chrome-dark);
    border-radius: 0.75rem;
    color: var(--color-frost);
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.9rem;
  }
  .reader-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--color-lime);
    color: var(--color-ink);
    animation: pulse 1.8s ease-in-out infinite;
  }
  .reader-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(142 192 8 / 0.25);
    }
  }
  .glow {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 0;
    height: 3px;
    border-radius: 999px;
    background: var(--color-frost);
    box-shadow: 0 0 14px 3px rgb(255 255 255 / 0.6);
  }

  /*
   * Two glass doors. The rows are shared across both doors (subgrid), and every
   * row is 1fr, so all eight cards come out the same size.
   */
  .doors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, 1fr);
    gap: 0 clamp(0.4rem, 1vw, 0.7rem);
    padding: clamp(0.5rem, 1.2vw, 0.8rem) 0;
  }
  .door {
    --frame: clamp(8px, 1.2vw, 12px);
    position: relative;
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(0.5rem, 1.2vw, 0.9rem);
    /* No vertical padding here: subgrid edge rows would absorb it and the cards would differ in size. */
    padding: 0 calc(var(--frame) + clamp(0.75rem, 1.6vw, 1.1rem));
    /* Lit, cold interior behind glass, with a glare streak. */
    background:
      linear-gradient(115deg, transparent 18%, rgb(255 255 255 / 0.4) 22%, transparent 27%),
      linear-gradient(115deg, transparent 60%, rgb(255 255 255 / 0.25) 62%, transparent 65%),
      radial-gradient(130% 80% at 50% 0%, var(--color-frost), var(--color-glass) 60%, var(--color-cold));
    /* The frame is an inset shadow, not a border, for the same reason. */
    border-radius: 0.6rem;
    box-shadow:
      inset 0 0 0 var(--frame) var(--color-machine-2),
      inset 0 0 0 calc(var(--frame) + 2px) rgb(0 0 0 / 0.35),
      inset 0 0 40px rgb(127 211 245 / 0.55);
  }
  .door-left {
    padding-right: calc(var(--frame) + clamp(1.25rem, 2.6vw, 1.9rem));
  }
  .door-right {
    padding-left: calc(var(--frame) + clamp(1.25rem, 2.6vw, 1.9rem));
  }
  .handle {
    position: absolute;
    top: 12%;
    bottom: 12%;
    width: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-chrome-dark), var(--color-frost) 45%, var(--color-chrome-dark));
    box-shadow: 0 3px 5px rgb(0 0 0 / 0.35);
  }
  .door-left .handle {
    right: calc(var(--frame) + 0.35rem);
  }
  .door-right .handle {
    left: calc(var(--frame) + 0.35rem);
  }

  .slot {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding-top: calc(var(--frame) + clamp(0.8rem, 1.6vw, 1.1rem));
  }
  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem 1rem 1.1rem;
    background: var(--tone);
    color: var(--color-ink);
    border: 3px solid var(--color-ink);
    border-radius: 0.7rem;
    box-shadow: 5px 5px 0 var(--color-ink);
    transition: transform 160ms, box-shadow 160ms;
  }
  .slot:hover .card {
    transform: translateY(-6px);
    box-shadow: 5px 11px 0 var(--color-ink);
  }
  .card-title {
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
  }
  .card-body {
    margin-top: 0.45rem;
    font-size: 1.02rem;
    line-height: 1.4;
  }
  .card-link {
    margin-top: auto;
    padding-top: 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Wire shelf with a price rail on the front edge. */
  .rail {
    position: relative;
    margin: 0.6rem calc(-1 * clamp(0.25rem, 0.6vw, 0.45rem)) calc(var(--frame) + 0.4rem);
    height: 1.4rem;
    background: linear-gradient(var(--color-chrome), var(--color-chrome-dark));
    border-radius: 3px;
    box-shadow: 0 4px 6px rgb(1 32 76 / 0.25);
  }
  .tag {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 0 0.5rem;
    background: var(--color-frost);
    border: 1.5px solid var(--color-ink);
    border-radius: 3px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.2;
    color: var(--color-ink);
  }

  /* Kick plate with a vent and a small badge. */
  .kick {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.25rem 0.9rem;
  }
  .vent {
    flex: 1;
    height: clamp(2.5rem, 5vw, 3.5rem);
    border-radius: 0.4rem;
    background: repeating-linear-gradient(var(--color-machine) 0 5px, var(--color-machine-2) 5px 9px);
    border: 2px solid var(--color-machine-2);
  }
  .badge {
    padding: 0.25rem 0.6rem;
    border: 1.5px solid var(--color-chrome-dark);
    border-radius: 0.3rem;
    color: var(--color-chrome);
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .casters {
    display: flex;
    justify-content: space-between;
    padding: 0 3%;
  }
  .casters span {
    width: 1.4rem;
    height: 1.4rem;
    margin-top: -0.2rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-chrome-dark) 30%, var(--color-machine) 34%);
  }

  /* Tablet: each door holds one column of four cards. */
  @media (max-width: 62rem) {
    .doors {
      grid-template-rows: repeat(4, 1fr);
    }
    .door {
      grid-row: span 4;
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Phone: doors stack, one card per shelf. */
  @media (max-width: 36rem) {
    .doors {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(8, 1fr);
      row-gap: 0;
    }
    .door-left,
    .door-right {
      padding-left: calc(var(--frame) + 0.6rem);
      padding-right: calc(var(--frame) + 1.4rem);
    }
    .door-right .handle {
      left: auto;
      right: calc(var(--frame) + 0.35rem);
    }
    .topper {
      flex-wrap: wrap;
    }
    .reader {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reader-icon {
      animation: none;
    }
    .card {
      transition: none;
    }
  }
</style>
