---
// Simple line icons drawn on each "product" in the machine window.
interface Props {
  code: string;
  class?: string;
}
const { code, class: cls = "" } = Astro.props;
---

<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  {code === "A1" && (
    <>
      <rect x="10" y="8" width="28" height="32" rx="4" />
      <path d="M16 32h16M16 26h16M16 20h10" />
      <path d="M33 14l3-3" />
    </>
  )}
  {code === "A2" && (
    <>
      <path d="M24 6v36M8.4 15l31.2 18M8.4 33l31.2-18" />
      <path d="M19 9l5 4 5-4M19 39l5-4 5 4" />
    </>
  )}
  {code === "A3" && (
    <>
      <rect x="8" y="14" width="22" height="26" rx="3" />
      <path d="M14 34h10" />
      <path d="M33 14a8 8 0 0 1 0 12M37 10a14 14 0 0 1 0 20" />
    </>
  )}
  {code === "B1" && (
    <>
      <path d="M8 20l3-10h26l3 10" />
      <path d="M8 20h32v4a5 5 0 0 1-10 0 5 5 0 0 1-12 0 5 5 0 0 1-10 0z" />
      <path d="M11 28v12h26V28M20 40v-8h8v8" />
    </>
  )}
  {code === "B2" && (
    <>
      <path d="M24 42s13-12 13-23a13 13 0 0 0-26 0c0 11 13 23 13 23z" />
      <circle cx="24" cy="19" r="5" />
    </>
  )}
  {code === "B3" && (
    <>
      <circle cx="17" cy="16" r="6" />
      <circle cx="32" cy="18" r="5" />
      <path d="M6 40c1-8 6-12 11-12s10 4 11 12M28 30c2-3 4-4 6-4 4 0 7 4 8 10" />
    </>
  )}
</svg>
