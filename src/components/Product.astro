---
// One item standing on a coil, drawn in SVG. The wrapper shows the slot's label,
// like a brand name on a real snack.
import type { Slot } from "../site";

interface Props {
  kind: Slot["product"];
  tone: Slot["tone"];
  label: string;
  class?: string;
}
const { kind, tone, label, class: cls = "" } = Astro.props;
const fill = `var(--color-${tone})`;
const ink = "var(--color-ink)";
const words = label.toUpperCase().split(" ");
// Shrink the print so the longest word fits the label band on this item.
const band = { bottle: 28, water: 22, can: 36, chips: 32, bar: 32, box: 40 }[kind];
const longest = Math.max(...words.map((w) => w.length));
const fontSize = Math.min(7.5, (band - 4) / (longest * 0.82));
---

<svg viewBox="0 0 60 100" class={cls} aria-hidden="true">
  {kind === "bottle" && (
    <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
      <rect x="24" y="4" width="12" height="7" rx="2" fill="var(--color-orange)" />
      <path d="M25 11h10v8c0 4 9 7 9 16v57a5 5 0 0 1-5 5H21a5 5 0 0 1-5-5V35c0-9 9-12 9-16z" fill={fill} />
      <rect x="16" y="48" width="28" height="26" fill="var(--color-frost)" />
      <path d="M21 30v50" stroke="var(--color-frost)" stroke-opacity="0.6" stroke-width="3" />
    </g>
  )}
  {kind === "can" && (
    <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
      <path d="M12 26c0-4 6-6 18-6s18 2 18 6v62c0 4-6 6-18 6s-18-2-18-6z" fill={fill} />
      <ellipse cx="30" cy="26" rx="18" ry="5" fill="var(--color-chrome)" />
      <rect x="12" y="46" width="36" height="26" fill="var(--color-frost)" />
      <path d="M18 34v52" stroke="var(--color-frost)" stroke-opacity="0.6" stroke-width="3" />
    </g>
  )}
  {kind === "water" && (
    <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
      <rect x="25" y="6" width="10" height="7" rx="2" fill="var(--color-ink)" />
      <path d="M26 13h8v6c0 3 7 6 7 13v60a5 5 0 0 1-5 5H24a5 5 0 0 1-5-5V32c0-7 7-10 7-13z" fill="var(--color-glass)" />
      <path d="M19 40h22v40H19z" fill={fill} />
      <path d="M19 52h22M19 64h22" stroke="var(--color-frost)" stroke-width="2" />
    </g>
  )}
  {kind === "chips" && (
    <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
      <path d="M8 24l4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4v72l-4 4-4-4-4 4-4-4-4 4-4-4-4 4-4-4-4 4-4-4-4 4z" fill={fill} />
      <ellipse cx="30" cy="60" rx="17" ry="15" fill="var(--color-frost)" />
    </g>
  )}
  {kind === "bar" && (
    <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
      <path d="M14 14h32l-3 5 3 5v66l-3 5 3 5H14l3-5-3-5V24l3-5z" fill={fill} />
      <rect x="14" y="40" width="32" height="34" fill="var(--color-frost)" />
    </g>
  )}
  {kind === "box" && (
    <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
      <rect x="10" y="22" width="40" height="74" rx="3" fill={fill} />
      <rect x="10" y="22" width="40" height="10" fill="var(--color-orange)" />
      <rect x="10" y="48" width="40" height="24" fill="var(--color-frost)" />
      <circle cx="22" cy="84" r="5" fill="var(--color-sun)" /><circle cx="38" cy="84" r="5" fill="var(--color-sun)" />
    </g>
  )}
  <text
    x="30"
    y={kind === "can" ? 58 : kind === "chips" ? 58 : kind === "bottle" ? 60 : kind === "water" ? 62 : 58}
    text-anchor="middle"
    font-family="var(--font-display)"
    font-size={fontSize}
    fill={ink}
  >
    {words.map((w, i) => <tspan x="30" dy={i === 0 ? (words.length > 1 ? -3.5 : 2.5) : 8.5}>{w}</tspan>)}
  </text>
</svg>
