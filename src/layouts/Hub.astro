---
// The owner hub: the "service panel" behind the machine. Light, plain, built for
// checking on a phone in a parking lot.
import "../theme.css";
import { site } from "../site";

interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user ?? "";
const path = Astro.url.pathname;

const nav = [
  { href: "/hub/", label: "Overview" },
  { href: "/hub/machines/", label: "Machines" },
  { href: "/hub/prices/", label: "Prices" },
  { href: "/hub/requests/", label: "Host requests" },
  { href: "/hub/settings/", label: "Settings" },
];
const current = (href: string) => (href === "/hub/" ? path === "/hub/" || path === "/hub" : path.startsWith(href.slice(0, -1)));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <meta name="robots" content="noindex" />
    <title>{title} | {site.name} hub</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:global>
      /* App on phones: fits the screen, no zoom, only scrolls up and down. 16px fields so iPhone does not zoom on tap. */
      html, body { max-width: 100%; overflow-x: clip; touch-action: pan-x pan-y; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
      input, select, textarea { font-size: 16px; max-width: 100%; }
    </style>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <header class="bg-cabinet text-inverse">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <a href="/hub/" class="flex items-center gap-3 rounded-control bg-frost px-3 py-1.5" aria-label={`${site.name} hub`}>
          <img src={site.logo} alt="" class="h-10 w-auto" />
          <span class="text-xl font-bold text-ink">hub</span>
        </a>
        {
          user && (
            <form method="POST" action="/hub/logout/" class="flex items-center gap-3 text-sm">
              <span class="text-chrome">Signed in as {user[0].toUpperCase() + user.slice(1)}</span>
              <button class="underline">Sign out</button>
            </form>
          )
        }
      </div>
      {
        user && (
          <nav class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-2 sm:px-4" aria-label="Hub">
            {nav.map((n) => (
              <a
                href={n.href}
                aria-current={current(n.href) ? "page" : undefined}
                class="rounded-t-lg px-4 py-2.5 text-sm font-semibold whitespace-nowrap text-chrome hover:text-frost aria-[current=page]:bg-paper aria-[current=page]:text-ink"
              >
                {n.label}
              </a>
            ))}
          </nav>
        )
      }
    </header>
    <main class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-8 sm:px-6">
      <slot />
    </main>
  </body>
</html>
