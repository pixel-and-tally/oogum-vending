---
import SiteCredit from "../components/SiteCredit.astro";
import "../theme.css";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.hometown}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const year = new Date().getFullYear();
const tabs = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About Us" },
];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class="flex min-h-screen flex-col bg-page text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-sun focus:px-4 focus:py-2 focus:text-ink"
      >Skip to content</a
    >
    <header class="relative z-10">
      <nav class="site-nav mx-auto w-full max-w-6xl px-4 pt-3 sm:px-6" aria-label="Main">
        <ul class="nav-tabs flex items-center gap-2 text-lg font-semibold">
          {
            tabs.map((t) => (
              <li>
                <a
                  href={t.href}
                  aria-current={here === t.href ? "page" : undefined}
                  class="whitespace-nowrap rounded-full px-5 py-2.5 text-ink hover:bg-lime-soft aria-[current=page]:bg-lime-soft aria-[current=page]:text-lime-dark"
                >
                  {t.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/" class="nav-logo justify-self-center md:-mb-8">
          {site.logo ? <img src={site.logo} alt={`${site.name} home`} class="h-24 w-auto sm:h-28 md:h-36" /> : <span class="font-display text-2xl">{site.name}</span>}
        </a>
        <div class="nav-actions flex items-center gap-5">
          {site.phone && <a href={`tel:${site.phone}`} class="hidden whitespace-nowrap text-lg font-semibold text-ink lg:inline">{site.phone}</a>}
          <a href="/host/" class="key key-vend nav-cta px-6 py-3 text-base lg:whitespace-nowrap">{site.cta}</a>
        </div>
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t-8 border-lime bg-cabinet text-inverse">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-10 text-sm sm:flex-row sm:justify-between sm:px-6">
        <div class="flex flex-col gap-1">
          <p class="font-display text-lg uppercase text-lime">{site.name}</p>
          <p>Owned by {site.owners}. {site.hometown}.</p>
          {site.phone && <p><a class="underline" href={`tel:${site.phone}`}>{site.phone}</a></p>}
          {site.email && <p><a class="underline" href={`mailto:${site.email}`}>{site.email}</a></p>}
        </div>
        <div class="flex flex-col gap-1 sm:items-end">
          <a href="/about/" class="underline">About us</a>
          <a href="/host/" class="underline">{site.cta}</a>
          <a href="/hub/" class="underline">Owner login</a>
          <p class="text-chrome">© {year} {site.name}</p>
        </div>
      </div>
      <!-- The Pixel & Tally credit sits alone in the bottom-right corner. -->
      <div class="mx-auto flex w-full max-w-6xl justify-end px-4 pb-6 sm:px-6">
        <SiteCredit class="text-chrome" />
      </div>
    </footer>
  </body>
</html>

<style>
  /* Logo in the middle, tabs on the left, the main button and phone on the right.
     On phones the logo sits on its own row above. */
  .site-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: "tabs logo actions";
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .nav-tabs { grid-area: tabs; justify-self: end; }
  .nav-logo { grid-area: logo; }
  .nav-actions { grid-area: actions; justify-self: start; }
  @media (min-width: 768px) {
    .site-nav { column-gap: 3rem; }
  }
  @media (max-width: 639px) {
    .site-nav {
      grid-template-columns: 1fr;
      grid-template-areas: "logo" "tabs" "actions";
      justify-items: center;
    }
    .nav-tabs, .nav-actions { justify-self: center; }
  }
</style>
